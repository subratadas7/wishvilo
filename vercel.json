{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "schedules": {
    "birthday-expiry-cleanup": {
      "path": "/api/cleanup",
      "schedule": "*/15 * * * *",
      "requestMethod": "GET"
    }
  }
}
